# ==============================================================================
# InvoiceGuard AI - Environment Variables Template
# ==============================================================================

# Blockchain Ledger Configuration
# Options: 'local' (auto-started Hardhat node), 'rpc' (external EVM chain), 'off'
INVOICEGUARD_LEDGER=local
INVOICEGUARD_LEDGER_SALT=invoiceguard-consortium-v1

# External RPC configuration (only used if INVOICEGUARD_LEDGER=rpc)
# INVOICEGUARD_CHAIN_RPC=http://127.0.0.1:8545
# INVOICEGUARD_CHAIN_KEY=
# INVOICEGUARD_CHAIN_CONTRACT=

# REST API Configuration (serves FastAPI alongside Streamlit or standalone)
INVOICEGUARD_API_PORT=8000
INVOICEGUARD_API_KEY=

# Webhook Integration (n8n, Slack, ERP notifications)
# INVOICEGUARD_WEBHOOK_URL=http://localhost:5678/webhook/invoiceguard
# INVOICEGUARD_WEBHOOK_SECRET=

# Optional LLM Vision Extraction (Claude Vision - 3rd extraction fallback)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# INVOICEGUARD_LLM_MODEL=claude-opus-5-5
# INVOICEGUARD_ENABLE_LLM=0

# Data directory path (default: data/)
# INVOICEGUARD_DATA_DIR=data

