{
  "name": "InvoiceGuard AI - email intake and approval alerts",
  "nodes": [
    {
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "read",
        "downloadAttachments": true,
        "options": {}
      },
      "id": "b7e1c0d2-0001-4c1a-9a01-000000000001",
      "name": "Invoices mailbox (IMAP)",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [260, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INVOICEGUARD_URL || 'http://127.0.0.1:8000' }}/api/invoices",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.INVOICEGUARD_API_KEY }}" }]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "attachment_0" },
            { "name": "uploader_id", "value": "emp_asha" }
          ]
        },
        "options": {}
      },
      "id": "b7e1c0d2-0002-4c1a-9a01-000000000002",
      "name": "Submit to InvoiceGuard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "invoiceguard-events",
        "options": {}
      },
      "id": "b7e1c0d2-0003-4c1a-9a01-000000000003",
      "name": "InvoiceGuard events (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 460],
      "webhookId": "invoiceguard-events"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.event_type }}",
              "rightValue": "APPROVAL_REQUESTED",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.body.event_type }}",
              "rightValue": "INVOICE_ESCALATED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "b7e1c0d2-0004-4c1a-9a01-000000000004",
      "name": "Needs a human?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 460]
    },
    {
      "parameters": {
        "fromEmail": "invoiceguard@example.com",
        "toEmail": "accounts-managers@example.com",
        "subject": "={{ $json.body.event_type === 'INVOICE_ESCALATED' ? 'Escalated' : 'Approval needed' }}: {{ $json.body.invoice_id }}",
        "emailFormat": "text",
        "text": "=Invoice {{ $json.body.invoice_id }} needs a human decision.\nEvent: {{ $json.body.event_type }}\nDetails: {{ JSON.stringify($json.body.data) }}\nAudit hash: {{ $json.body.audit_hash }}\n\nOpen InvoiceGuard to review. Approvals are only possible in the InvoiceGuard UI.",
        "options": {}
      },
      "id": "b7e1c0d2-0005-4c1a-9a01-000000000005",
      "name": "Email accounts managers",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [780, 440]
    }
  ],
  "connections": {
    "Invoices mailbox (IMAP)": { "main": [[{ "node": "Submit to InvoiceGuard", "type": "main", "index": 0 }]] },
    "InvoiceGuard events (webhook)": { "main": [[{ "node": "Needs a human?", "type": "main", "index": 0 }]] },
    "Needs a human?": { "main": [[{ "node": "Email accounts managers", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
